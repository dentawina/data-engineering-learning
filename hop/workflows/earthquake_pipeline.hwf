<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>earthquake_pipeline</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>USGS ELT: replace Silver, then replace daily Gold summary</description>
  <extended_description/>
  <workflow_version/>
  <created_user>portfolio</created_user>
  <modified_user>portfolio</modified_user>
  <parameters/>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>1</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <attributes_hac/>
      <xloc>80</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>silver</name>
      <description>Clean, quality-check, deduplicate, and replace Silver</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <filename>${Internal.Entry.Current.Folder}/../pipelines/usgs_silver.hpl</filename>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <parallel>N</parallel>
      <attributes_hac/>
      <xloc>280</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>gold</name>
      <description>Aggregate Silver into the daily Gold summary</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <filename>${Internal.Entry.Current.Folder}/../pipelines/usgs_gold.hpl</filename>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <parallel>N</parallel>
      <attributes_hac/>
      <xloc>480</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <attributes_hac/>
      <xloc>680</xloc>
      <yloc>160</yloc>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>silver</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>silver</from>
      <to>gold</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>gold</from>
      <to>Success</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>
