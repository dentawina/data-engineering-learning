    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>336</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>read silver</name>
    <sql>SELECT
    observation_date,
    city,
    MAX(province) AS province,
    source,

    MIN(temperature_2m) AS min_temperature,
    MAX(temperature_2m) AS max_temperature,
    ROUND(AVG(temperature_2m), 2) AS avg_temperature,

    ROUND(
        AVG(apparent_temperature),
        2
    ) AS avg_apparent_temperature,

    MIN(relative_humidity_2m) AS min_humidity,
    MAX(relative_humidity_2m) AS max_humidity,

    ROUND(
        AVG(relative_humidity_2m),
        2
    ) AS avg_humidity,

    ROUND(
        SUM(COALESCE(precipitation, 0)),
        2
    ) AS total_precipitation,

    ROUND(
        SUM(COALESCE(rain, 0)),
        2
    ) AS total_rain,

    COUNT(*) FILTER (
        WHERE is_raining = true
    )::integer AS rainy_hours,

    ROUND(
        AVG(cloud_cover),
        2
    ) AS avg_cloud_cover,

    MAX(wind_speed_10m) AS max_wind_speed,

    ROUND(
        AVG(surface_pressure),
        2
    ) AS avg_surface_pressure,

    COUNT(*)::integer AS observation_count,

    ROUND(
        LEAST(COUNT(DISTINCT observation_hour), 24)::numeric
        / 24 * 100,
        2
    ) AS completeness_percentage,

    ROUND(
        AVG(ingestion_lag_minutes),
        2
    ) AS avg_ingestion_lag_minutes,

    MIN(observed_at) AS first_observed_at,
    MAX(observed_at) AS last_observed_at,
    now() AS processed_at

FROM silver.weather_observation

GROUP BY
    observation_date,
    city,
    source;</sql>
