    <modified_date>2026/08/18 11:04:50.263</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>read bronze</name>
    <sql>SELECT
    observed_at,
    observed_at::date AS observation_date,
    EXTRACT(HOUR FROM observed_at)::smallint AS observation_hour,

    TRIM(city) AS city,
    TRIM(province) AS province,
    latitude,
    longitude,
    TRIM(timezone) AS timezone,
    TRIM(source) AS source,

    temperature_2m,
    apparent_temperature,

    CASE
        WHEN temperature_2m IS NULL THEN 'unknown'
        WHEN temperature_2m &lt; 20 THEN 'cool'
        WHEN temperature_2m &lt; 25 THEN 'comfortable'
        WHEN temperature_2m &lt; 30 THEN 'warm'
        ELSE 'hot'
    END AS temperature_category,

    relative_humidity_2m,

    CASE
        WHEN relative_humidity_2m IS NULL THEN 'unknown'
        WHEN relative_humidity_2m &lt; 30 THEN 'dry'
        WHEN relative_humidity_2m &lt; 60 THEN 'comfortable'
        WHEN relative_humidity_2m &lt; 80 THEN 'humid'
        ELSE 'very_humid'
    END AS humidity_category,

    precipitation,
    rain,
    weather_code,

    CASE
        WHEN weather_code IS NULL THEN 'unknown'
        WHEN weather_code = 0 THEN 'clear_sky'
        WHEN weather_code = 1 THEN 'mainly_clear'
        WHEN weather_code = 2 THEN 'partly_cloudy'
        WHEN weather_code = 3 THEN 'overcast'
        WHEN weather_code = 45 THEN 'fog'
        WHEN weather_code = 48 THEN 'depositing_rime_fog'
        WHEN weather_code = 51 THEN 'light_drizzle'
        WHEN weather_code = 53 THEN 'moderate_drizzle'
        WHEN weather_code = 55 THEN 'dense_drizzle'
        WHEN weather_code = 56 THEN 'light_freezing_drizzle'
        WHEN weather_code = 57 THEN 'dense_freezing_drizzle'
        WHEN weather_code = 61 THEN 'slight_rain'
        WHEN weather_code = 63 THEN 'moderate_rain'
        WHEN weather_code = 65 THEN 'heavy_rain'
        WHEN weather_code = 66 THEN 'light_freezing_rain'
        WHEN weather_code = 67 THEN 'heavy_freezing_rain'
        WHEN weather_code = 71 THEN 'slight_snowfall'
        WHEN weather_code = 73 THEN 'moderate_snowfall'
        WHEN weather_code = 75 THEN 'heavy_snowfall'
        WHEN weather_code = 77 THEN 'snow_grains'
        WHEN weather_code = 80 THEN 'slight_rain_showers'
        WHEN weather_code = 81 THEN 'moderate_rain_showers'
        WHEN weather_code = 82 THEN 'violent_rain_showers'
        WHEN weather_code = 85 THEN 'slight_snow_showers'
        WHEN weather_code = 86 THEN 'heavy_snow_showers'
        WHEN weather_code = 95 THEN 'thunderstorm'
        WHEN weather_code = 96 THEN 'thunderstorm_with_slight_hail'
        WHEN weather_code = 99 THEN 'thunderstorm_with_heavy_hail'
        ELSE 'unknown_weather_code'
    END AS weather_description,

    cloud_cover,

    CASE
        WHEN cloud_cover IS NULL THEN 'unknown'
        WHEN cloud_cover &lt;= 10 THEN 'clear'
        WHEN cloud_cover &lt;= 30 THEN 'mostly_clear'
        WHEN cloud_cover &lt;= 60 THEN 'partly_cloudy'
        WHEN cloud_cover &lt;= 90 THEN 'mostly_cloudy'
        ELSE 'overcast'
    END AS cloud_cover_category,

    surface_pressure,
    wind_speed_10m,
    wind_direction_10m,

    COALESCE(rain, 0) > 0 AS is_raining,

    ROUND(
        EXTRACT(EPOCH FROM (ingest_at - observed_at)) / 60
    )::integer AS ingestion_lag_minutes,

    ingest_at,
    now() AS processed_at

FROM public.scrapper_openmeteo

WHERE observed_at IS NOT NULL
  AND city IS NOT NULL
  AND latitude IS NOT NULL
  AND longitude IS NOT NULL;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>supabase_denta</connection>
    <lookup/>
