<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>weather_gold</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>portfolio</created_user>
    <modified_user>portfolio</modified_user>
  </info>
  <transform>
    <type>TableInput</type>
    <name>read silver</name>
    <sql>SELECT
    observation_date,
    city,
    MAX(province) AS province,
    source,
    MIN(temperature_2m) AS min_temperature,
    MAX(temperature_2m) AS max_temperature,
    ROUND(AVG(temperature_2m), 2) AS avg_temperature,
    ROUND(AVG(apparent_temperature), 2) AS avg_apparent_temperature,
    MIN(relative_humidity_2m) AS min_humidity,
    MAX(relative_humidity_2m) AS max_humidity,
    ROUND(AVG(relative_humidity_2m), 2) AS avg_humidity,
    ROUND(SUM(COALESCE(precipitation, 0)), 2) AS total_precipitation,
    ROUND(SUM(COALESCE(rain, 0)), 2) AS total_rain,
    COUNT(*) FILTER (WHERE is_raining = true)::integer AS rainy_hours,
    ROUND(AVG(cloud_cover), 2) AS avg_cloud_cover,
    MAX(wind_speed_10m) AS max_wind_speed,
    ROUND(AVG(surface_pressure), 2) AS avg_surface_pressure,
    COUNT(*)::integer AS observation_count,
    ROUND(
        LEAST(COUNT(DISTINCT observation_hour), 24)::numeric / 24 * 100,
        2
    ) AS completeness_percentage,
    ROUND(AVG(ingestion_lag_minutes), 2) AS avg_ingestion_lag_minutes,
    MIN(observed_at) AS first_observed_at,
    MAX(observed_at) AS last_observed_at,
    now() AS processed_at
FROM silver.weather_observation
GROUP BY
    observation_date,
    city,
    source;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>supabase_denta</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>insert to gold</name>
    <connection>supabase_denta</connection>
    <schema>gold</schema>
    <table>weather_daily_summary</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>N</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>336</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>read silver</from>
      <to>insert to gold</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
